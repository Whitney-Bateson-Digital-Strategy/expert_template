---
export interface Props {
  eyebrow?: string;
  heading: string;
  description: string;
  image: { src: string; alt: string; width?: number; height?: number };
  ctaLabel?: string;
  ctaHref: string;
  background?: 'accent' | 'accent-light' | 'primary' | 'accent2' | 'accent2-light';
}

const {
  eyebrow = 'Free resource',
  heading,
  description,
  image,
  ctaLabel = 'Download the guide',
  ctaHref,
  background = 'accent',
} = Astro.props;

const bgMap: Record<string, string> = {
  accent: 'bg-accent',
  'accent-light': 'bg-accent-light',
  primary: 'bg-primary',
  accent2: 'bg-accent2',
  'accent2-light': 'bg-accent2-light',
};

const isDark = background === 'accent' || background === 'primary' || background === 'accent2';
const headingText = isDark ? 'text-white' : '';
const mutedText = isDark ? 'text-white/80' : 'text-text-muted';
const eyebrowColor = isDark ? 'text-white/60' : 'text-primary';
const ruleColor = isDark ? 'bg-white/40' : 'bg-border-strong';
---

<section class={bgMap[background]} data-section-bg={background}>
  <div class="container-page section-py">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16 items-center">

      <!-- Guide mockup -->
      <div class="lg:col-span-5 order-first">
        <img
          src={image.src}
          alt={image.alt}
          class="w-full max-w-sm mx-auto lg:mx-0 aspect-[4/5] object-cover shadow-2xl"
          width={image.width}
          height={image.height}
          loading="lazy"
          decoding="async"
        />
      </div>

      <!-- Text -->
      <div class="lg:col-span-7">
        {eyebrow && (
          <div class="flex items-center gap-4 mb-6">            <p class={`eyebrow ${eyebrowColor}`}>{eyebrow}</p>
          </div>
        )}

        <h2 class={`text-4xl md:text-5xl leading-[1.05] max-w-[16ch] ${headingText}`}>{heading}</h2>

        <p class={`mt-6 max-w-xl leading-relaxed ${mutedText}`}>{description}</p>

        <div class="mt-9">
          <a
            href={ctaHref}
            class={`eyebrow inline-flex items-center gap-2 px-8 py-4 rounded-[var(--radius-button)] transition-colors duration-200 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-offset-2 ${
              isDark
                ? 'bg-white text-accent hover:bg-white/90 focus-visible:ring-white'
                : 'bg-accent text-white hover:bg-primary-dark focus-visible:ring-text-heading'
            }`}
          >
            {ctaLabel}
          </a>
        </div>
      </div>

    </div>
  </div>
</section>
