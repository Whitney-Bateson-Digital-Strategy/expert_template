---
import Button from '~/components/ui/Button.astro';
import SectionWrapper from '~/components/common/SectionWrapper.astro';

export interface Props {
  eyebrow?: string;
  heading: string;
  body: string[];
  image: { src: string; alt: string; width?: number; height?: number };
  cta: { text: string; href: string };
  panelBackground?: 'primary' | 'accent' | 'accent2' | 'accent-light' | 'accent2-light' | 'subtle';
  imagePosition?: 'left' | 'right';
}

const {
  eyebrow,
  heading,
  body,
  image,
  cta,
  panelBackground = 'accent2-light',
  imagePosition = 'left',
} = Astro.props;

const panelBgMap: Record<string, string> = {
  primary: 'bg-primary',
  accent: 'bg-accent',
  accent2: 'bg-accent2',
  'accent-light': 'bg-accent-light',
  'accent2-light': 'bg-accent2-light',
  subtle: 'bg-bg-subtle',
};

const isDark = panelBackground === 'primary' || panelBackground === 'accent' || panelBackground === 'accent2';
const headingText = isDark ? 'text-white' : '';
const bodyText = isDark ? 'text-white/80' : 'text-text-muted';
const eyebrowColor = isDark ? 'text-white/60' : 'text-primary';
const imgRight = imagePosition === 'right';
---

<SectionWrapper class="bg-bg-base" bg="base">

  <div class="grid grid-cols-1 lg:grid-cols-12 items-stretch">

    <!-- Image -->
    <div class={`${imgRight ? 'lg:order-2' : 'lg:order-1'} lg:col-span-5`}>
      <img
        src={image.src}
        alt={image.alt}
        class="w-full h-full min-h-[22rem] object-cover object-center grayscale-[15%]"
        width={image.width}
        height={image.height}
        loading="lazy"
        decoding="async"
      />
    </div>

    <!-- Colored / paper panel -->
    <div
      class={`${panelBgMap[panelBackground]} ${imgRight ? 'lg:order-1' : 'lg:order-2'} lg:col-span-7 flex items-center`}
    >
      <div class="px-8 py-12 md:px-14 md:py-16 lg:px-16 lg:py-20">
        {eyebrow && (
          <p class={`eyebrow mb-6 ${eyebrowColor}`}>{eyebrow}</p>
        )}

        <h2 class={`text-4xl md:text-5xl leading-[1.05] ${headingText}`} set:html={heading} />

        <div class="mt-7 flex flex-col gap-4 max-w-lg">
          {body.map((paragraph) => (
            <p class={`leading-relaxed ${bodyText}`}>{paragraph}</p>
          ))}
        </div>

        <div class="mt-9">
          <Button href={cta.href} variant={isDark ? 'outline' : 'primary'}>{cta.text}</Button>
        </div>
      </div>
    </div>

  </div>

</SectionWrapper>
