---
import Button from '~/components/ui/Button.astro';

interface TrustStat {
  type: 'stat';
  value: string;
  label: string;
}

interface TrustTestimonial {
  type: 'testimonial';
  quote: string;
  author: string;
}

interface TrustLogos {
  type: 'logos';
  label: string;
  logos: { src: string; alt: string }[];
}

type Trust = TrustStat | TrustTestimonial | TrustLogos;

export interface Props {
  tagline?: string;
  headline: string;
  subheadline: string;
  primaryCta: { text: string; href: string };
  secondaryCta?: { text: string; href: string };
  image: { src: string; alt: string; width?: number; height?: number };
  trust?: Trust;
}

const { tagline, headline, subheadline, primaryCta, secondaryCta, image, trust } = Astro.props;
---

<section class="bg-bg-base pt-10 pb-0 md:pt-16" data-section-bg="base">
  <div class="container-wide">

    <!-- Asymmetric editorial grid: oversized display left, tall image right -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-8 items-end">

      <div class="lg:col-span-7 lg:pb-20">
        {tagline && (
          <div class="flex items-center gap-4 mb-8">
            <span class="h-px w-10 bg-border-strong" aria-hidden="true"></span>
            <p class="eyebrow text-primary">{tagline}</p>
          </div>
        )}

        <h1 class="max-w-[15ch] text-[2.9rem] sm:text-6xl lg:text-[5.5rem] leading-[0.98]">
          <Fragment set:html={headline} />
        </h1>

        <div class="mt-8 max-w-xl text-lg leading-relaxed text-text-muted">
          <Fragment set:html={subheadline} />
        </div>

        <div class="mt-10 flex flex-wrap items-center gap-x-8 gap-y-4">
          <Button href={primaryCta.href} variant="primary">{primaryCta.text}</Button>
          {secondaryCta && (
            <Button href={secondaryCta.href} variant="link">{secondaryCta.text}</Button>
          )}
        </div>
      </div>

      <div class="lg:col-span-5 relative">
        <div class="relative">
          <img
            src={image.src}
            alt={image.alt}
            class="w-full aspect-[4/5] object-cover object-center grayscale-[15%]"
            width={image.width}
            loading="eager"
            fetchpriority="high"
            decoding="async"
          />
          <span class="absolute -top-3 -left-3 w-16 h-16 border-t border-l border-border-strong hidden lg:block" aria-hidden="true"></span>
        </div>

        {trust && (
          <div class="mt-6">
            {trust.type === 'stat' && (
              <div class="flex items-baseline gap-3">
                <span class="font-heading text-5xl text-text-heading">{trust.value}</span>
                <span class="text-sm text-text-muted max-w-[16ch]">{trust.label}</span>
              </div>
            )}
            {trust.type === 'testimonial' && (
              <blockquote class="border-t border-border pt-5">
                <p class="text-[0.98rem] text-text-base italic leading-relaxed">&ldquo;{trust.quote}&rdquo;</p>
                <cite class="eyebrow text-text-muted not-italic mt-3 block">{trust.author}</cite>
              </blockquote>
            )}
            {trust.type === 'logos' && (
              <div class="border-t border-border pt-5">
                <p class="eyebrow text-text-muted mb-3">{trust.label}</p>
                <div class="flex flex-wrap items-center gap-6">
                  {trust.logos.map((logo) => (
                    <img src={logo.src} alt={logo.alt} class="h-6 w-auto grayscale opacity-50" />
                  ))}
                </div>
              </div>
            )}
          </div>
        )}
      </div>

    </div>
  </div>
</section>
