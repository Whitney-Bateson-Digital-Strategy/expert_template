---
export interface Props {
  heading?: string;
  description?: string;
  ctaLabel?: string;
  ctaHref?: string;
}

const {
  heading = 'Ready to take the next step?',
  description,
  ctaLabel = 'Get the field guide',
  ctaHref = '#',
} = Astro.props;
---

<aside class="my-12 bg-accent px-8 py-10 not-prose rounded-[var(--radius-card)]">
  <div class="flex flex-col sm:flex-row sm:items-center gap-6 sm:gap-10">
    <div class="flex-1">
      <p class="font-heading text-2xl md:text-3xl text-white leading-snug mb-1">{heading}</p>
      {description && <p class="text-white/70 leading-relaxed">{description}</p>}
    </div>
    <div class="flex-shrink-0">
      <a
        href={ctaHref}
        class="eyebrow inline-flex items-center justify-center px-8 py-4 rounded-[var(--radius-button)] bg-white text-accent hover:bg-white/90 transition-colors duration-150 whitespace-nowrap"
      >
        {ctaLabel}
      </a>
    </div>
  </div>
</aside>
