---
export const prerender = true;
import Layout from '~/layouts/PageLayout.astro';
import { getAllPosts, formatDate } from '~/utils/blog';

const posts = await getAllPosts();

const metadata = {
  title: 'Journal: Notes, Essays & Practical Thinking',
  description: 'Essays and practical notes on doing meaningful work well, clear thinking for real life.',
};
---

<Layout metadata={metadata}>
  <section class="py-20 md:py-28">
    <div class="container-page">

      <div class="max-w-3xl mb-16 md:mb-20">
        <div class="flex items-center gap-4 mb-7">
          <p class="eyebrow text-primary">The Journal</p>
        </div>
        <h1 class="text-5xl md:text-7xl leading-[1.02]">Notes for <em>real life.</em></h1>
        <p class="mt-7 text-text-muted text-lg leading-relaxed">
          Essays and practical thinking on doing the work well, cutting through the noise, one idea at a time.
        </p>
      </div>

      <div class="border-t border-border">
        {posts.map((post) => (
          <article class="grid grid-cols-1 md:grid-cols-12 gap-4 md:gap-8 py-10 md:py-12 border-b border-border items-baseline group">
            <div class="md:col-span-3">
              <time class="eyebrow text-text-muted" datetime={post.data.publishDate.toISOString()}>
                {formatDate(post.data.publishDate)}
              </time>
              {post.data.tags && post.data.tags.length > 0 && (
                <p class="eyebrow text-primary mt-2">{post.data.tags[0]}</p>
              )}
            </div>
            <div class="md:col-span-9">
              <h2 class="text-3xl md:text-4xl leading-[1.1]">
                <a href={`/${post.id}`} class="hover:text-text-base transition-colors duration-150">
                  {post.data.title}
                </a>
              </h2>
              {post.data.excerpt && (
                <p class="mt-4 text-text-muted leading-relaxed max-w-2xl">{post.data.excerpt}</p>
              )}
              <a
                href={`/${post.id}`}
                class="mt-5 inline-flex items-center gap-2 eyebrow text-text-heading border-b border-text-heading/30 pb-1 group-hover:border-text-heading transition-colors duration-200"
              >
                Read the essay →
              </a>
            </div>
          </article>
        ))}
      </div>

      {posts.length === 0 && <p class="text-text-muted">No posts yet. Check back soon.</p>}

    </div>
  </section>
</Layout>
