---
import Layout from '~/layouts/PageLayout.astro';
import PageHero from '~/components/sections/PageHero.astro';
import ContactForm from '~/components/sections/ContactForm.astro';
import CtaFinal from '~/components/sections/CtaFinal.astro';

const metadata = {
  title: 'Contact',
  description: 'Get in touch with Meridian. Send a message, ask a question, or learn more about working together.',
};
---

<Layout metadata={metadata}>

  {/* 1. Hero */}
  <PageHero
    variant="centered"
    background="accent2-light"
    eyebrow="Say hello"
    heading="Let's <em>talk.</em>"
    body={[
      "Whether you have a question, want to learn more about a service, or just aren't sure where to start, I'd love to hear from you.",
    ]}
  />

  {/* 2. Contact info + form */}
  <ContactForm background="base" />

  {/* 3. Final CTA */}
  <CtaFinal
    eyebrow="Prefer to talk first?"
    heading="Book a discovery call."
    subheading="A twenty-minute conversation is the easiest way to figure out if we're a good fit. No prep required."
    primaryCta={{ text: 'Book a Discovery Call', href: '/booking' }}
    background="primary"
  />

</Layout>
