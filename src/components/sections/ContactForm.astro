---
import { Icon } from 'astro-icon/components';
import SectionWrapper from '~/components/common/SectionWrapper.astro';
import Button from '~/components/ui/Button.astro';

export interface Props {
  background?: 'base' | 'subtle' | 'accent2-light';
}

const { background = 'base' } = Astro.props;

const bgMap: Record<string, string> = {
  base: 'bg-bg-base',
  subtle: 'bg-bg-subtle',
  'accent2-light': 'bg-accent2-light',
};

const inputClass =
  'rounded-[var(--radius-input)] border border-border bg-bg-card px-4 py-3 text-text-base placeholder:text-text-muted/60 focus:outline-none focus:border-text-heading transition-colors';
---

<SectionWrapper class={bgMap[background]} bg={background}>

  <div class="grid grid-cols-1 lg:grid-cols-[5fr_7fr] gap-12 lg:gap-20 items-start">

    <!-- Contact info -->
    <div class="order-2 lg:order-1">
      <div class="flex items-center gap-4 mb-6">
        <span class="h-px w-8 bg-border-strong" aria-hidden="true"></span>
        <p class="eyebrow text-primary">Say hello</p>
      </div>

      <h2 class="text-4xl md:text-5xl leading-[1.05]">Get in touch.</h2>
      <p class="mt-6 text-text-muted leading-relaxed max-w-md">
        Have a question or want to explore working together? Send a note and you'll hear
        back within one to two business days.
      </p>

      <div class="mt-10 border-t border-border">
        <div class="flex gap-5 items-start py-6 border-b border-border">
          <Icon name="tabler:map-pin" class="w-5 h-5 mt-0.5 text-primary flex-shrink-0" aria-hidden="true" />
          <div>
            <p class="eyebrow text-text-heading mb-1">Location</p>
            <p class="text-text-muted">Remote-first · In person by appointment</p>
          </div>
        </div>

        <div class="flex gap-5 items-start py-6 border-b border-border">
          <Icon name="tabler:mail" class="w-5 h-5 mt-0.5 text-primary flex-shrink-0" aria-hidden="true" />
          <div>
            <p class="eyebrow text-text-heading mb-1">Email</p>
            <a href="mailto:hello@example.com" class="text-text-heading border-b border-text-heading/30 hover:border-text-heading transition-colors">hello@example.com</a>
          </div>
        </div>

        <div class="flex gap-5 items-start py-6 border-b border-border">
          <Icon name="tabler:brand-instagram" class="w-5 h-5 mt-0.5 text-primary flex-shrink-0" aria-hidden="true" />
          <div>
            <p class="eyebrow text-text-heading mb-1">Elsewhere</p>
            <a href="#" class="text-text-heading border-b border-text-heading/30 hover:border-text-heading transition-colors">@meridian</a>
          </div>
        </div>
      </div>
    </div>

    <!-- Form -->
    <div class="order-1 lg:order-2 bg-bg-card border border-border p-8 md:p-10 rounded-[var(--radius-card)]">
      <form
        name="contact"
        method="POST"
        action="/thank-you"
        data-netlify="true"
        {...{ netlify: true }}
        netlify-honeypot="bot-field"
        class="flex flex-col gap-5"
      >
        <input type="hidden" name="form-name" value="contact" />
        <p class="hidden">
          <label>Don't fill this out: <input name="bot-field" /></label>
        </p>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
          <div class="flex flex-col gap-2">
            <label for="first-name" class="eyebrow text-text-heading">First name <span class="text-primary" aria-hidden="true">*</span></label>
            <input id="first-name" type="text" name="first-name" required autocomplete="given-name" class={inputClass} placeholder="Jane" />
          </div>
          <div class="flex flex-col gap-2">
            <label for="last-name" class="eyebrow text-text-heading">Last name <span class="text-primary" aria-hidden="true">*</span></label>
            <input id="last-name" type="text" name="last-name" required autocomplete="family-name" class={inputClass} placeholder="Smith" />
          </div>
        </div>

        <div class="flex flex-col gap-2">
          <label for="email" class="eyebrow text-text-heading">Email <span class="text-primary" aria-hidden="true">*</span></label>
          <input id="email" type="email" name="email" required autocomplete="email" class={inputClass} placeholder="jane@example.com" />
        </div>

        <div class="flex flex-col gap-2">
          <label for="phone" class="eyebrow text-text-heading">Phone <span class="text-text-muted font-normal normal-case tracking-normal">(optional)</span></label>
          <input id="phone" type="tel" name="phone" autocomplete="tel" class={inputClass} placeholder="(000) 000-0000" />
        </div>

        <div class="flex flex-col gap-2">
          <label for="interest" class="eyebrow text-text-heading">What are you hoping to work on?</label>
          <select id="interest" name="interest" class={inputClass}>
            <option value="">Select one (optional)</option>
            <option value="private">Private consultation</option>
            <option value="cohort">The group program</option>
            <option value="intensive">A single intensive</option>
            <option value="not-sure">Not sure yet</option>
            <option value="other">Something else</option>
          </select>
        </div>

        <div class="flex flex-col gap-2">
          <label for="message" class="eyebrow text-text-heading">Message <span class="text-primary" aria-hidden="true">*</span></label>
          <textarea id="message" name="message" required rows="5" class={`${inputClass} resize-y min-h-[8rem]`} placeholder="Tell me a little about what you're looking for…"></textarea>
        </div>

        <div class="pt-1">
          <Button type="submit" variant="primary" class="w-full justify-center">Send message</Button>
        </div>
      </form>
    </div>

  </div>

</SectionWrapper>
