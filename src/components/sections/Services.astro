---
import { Icon } from 'astro-icon/components';
import SectionWrapper from '~/components/common/SectionWrapper.astro';

export interface Service {
  image: { src: string; alt: string; width?: number; height?: number };
  label: string;
  name: string;
  description: string;
  ctaLabel: string;
  ctaHref: string;
}

export interface Props {
  heading: string;
  intro?: string;
  services: Service[];
  background?: 'base' | 'subtle' | 'accent-light' | 'primary' | 'accent';
}

const { heading, intro, services, background = 'base' } = Astro.props;

const bgMap: Record<string, string> = {
  base: 'bg-bg-base',
  subtle: 'bg-bg-subtle',
  'accent-light': 'bg-accent-light',
  primary: 'bg-primary',
  accent: 'bg-accent',
};

const isDark = background === 'primary' || background === 'accent';
const headingText = isDark ? 'text-white' : '';
const mutedText = isDark ? 'text-white/70' : 'text-text-muted';
const labelColor = isDark ? 'text-white/50' : 'text-primary';
const ruleColor = isDark ? 'border-white/20' : 'border-border';
const linkColor = isDark ? 'text-white border-white/40 hover:border-white' : 'text-text-heading border-text-heading/30 hover:border-text-heading';
---

<SectionWrapper class={bgMap[background]} bg={background}>

  <!-- Header -->
  <div class="max-w-3xl mb-14 md:mb-20">
    <div class="mb-6 flex items-center gap-4">
      <span class={`w-px h-8 ${isDark ? 'bg-white/50' : 'bg-primary/60'}`} aria-hidden="true"></span>
      <p class={`eyebrow ${labelColor}`}>N&#176;03</p>
    </div>
    <h2 class={`text-4xl md:text-6xl leading-[1.03] ${headingText}`} set:html={heading} />
    {intro && (
      <p class={`mt-6 max-w-2xl leading-relaxed ${mutedText}`}>{intro}</p>
    )}
  </div>

  <!-- Service cards -->
  <div class="grid grid-cols-1 md:grid-cols-3 gap-x-10 gap-y-14">
    {services.map((service, i) => (
      <a href={service.ctaHref} class="group flex flex-col" aria-label={`${service.ctaLabel}: ${service.name}`}>

        <div class="overflow-hidden mb-6 duotone">
          <img
            src={service.image.src}
            alt={service.image.alt}
            class="w-full aspect-[5/4] object-cover transition-transform duration-500 group-hover:scale-105"
            width={service.image.width}
            height={service.image.height}
            loading="lazy"
            decoding="async"
          />
        </div>

        <div class={`flex items-center gap-4 border-t ${ruleColor} pt-5`}>
          <span class={`font-heading text-xl ${labelColor}`}>{String(i + 1).padStart(2, '0')}</span>
          <p class={`eyebrow ${labelColor}`}>{service.label}</p>
        </div>

        <h3 class={`mt-4 text-[1.7rem] leading-tight ${headingText}`}>{service.name}</h3>

        <p class={`mt-3 leading-relaxed flex-1 ${mutedText}`}>{service.description}</p>

        <span class={`mt-6 inline-flex items-center gap-2 self-start eyebrow border-b pb-1 transition-colors duration-200 ${linkColor}`}>
          {service.ctaLabel}
          <Icon name="tabler:arrow-right" class="w-4 h-4 transition-transform duration-200 group-hover:translate-x-1" aria-hidden="true" />
        </span>

      </a>
    ))}
  </div>

</SectionWrapper>
