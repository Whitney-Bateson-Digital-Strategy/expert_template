---
export interface StoryCard {
  heading: string;
  body: string;
}

export interface Props {
  eyebrow?: string;
  name: string;
  title?: string;
  intro: string[];
  image: { src: string; alt: string; width?: number; height?: number };
  cards: StoryCard[];
  cta?: { text: string; href: string };
  background?: 'base' | 'subtle' | 'accent-light' | 'accent2-light';
}

const { eyebrow, name, title, intro, image, cards, cta, background = 'base' } = Astro.props;

const bgMap: Record<string, string> = {
  base: 'bg-bg-base',
  subtle: 'bg-bg-subtle',
  'accent-light': 'bg-accent-light',
  'accent2-light': 'bg-accent2-light',
};
---

<section class={`section-py ${bgMap[background]}`} data-section-bg={background}>
  <div class="container-page">

    <!-- Split: tall image left, narrative right -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-16 items-start mb-20 md:mb-28">

      <div class="lg:col-span-5 order-last lg:order-first">
        <img
          src={image.src}
          alt={image.alt}
          class="w-full aspect-[4/5] object-cover object-top grayscale-[15%]"
          width={image.width}
          height={image.height}
          loading="lazy"
          decoding="async"
        />
      </div>

      <div class="lg:col-span-7 lg:pt-4">
        {eyebrow && <p class="eyebrow text-primary mb-4">{eyebrow}</p>}
        <h2 class="font-heading text-3xl md:text-4xl leading-tight text-text-heading">{name}</h2>
        {title && <p class="text-text-muted mt-1 mb-8">{title}</p>}

        <div class="flex flex-col gap-6">
          {intro.map((p, i) =>
            i === 1 ? (
              <p class="font-heading text-2xl md:text-[1.9rem] italic leading-snug text-text-heading">{p}</p>
            ) : (
              <p class="leading-relaxed text-text-muted">{p}</p>
            )
          )}
        </div>

        {cta && (
          <a
            href={cta.href}
            class="group inline-flex items-center gap-2 mt-8 eyebrow text-text-heading border-b border-text-heading/30 pb-1 hover:border-text-heading transition-colors duration-200"
          >
            {cta.text}
            <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 transition-transform duration-200 group-hover:translate-x-1" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3" />
            </svg>
          </a>
        )}
      </div>

    </div>

    <!-- Story cards — hairline-topped columns -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-x-12 gap-y-12">
      {cards.map((card, i) => (
        <div class="border-t border-border pt-7" data-reveal data-reveal-delay={i * 100}>
          <span class="font-heading text-4xl text-border-strong block mb-4">{String(i + 1).padStart(2, '0')}</span>
          <h3 class="text-2xl mb-3">{card.heading}</h3>
          <p class="leading-relaxed text-text-muted">{card.body}</p>
        </div>
      ))}
    </div>

  </div>
</section>
