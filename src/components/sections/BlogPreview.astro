---
import { Icon } from 'astro-icon/components';
import SectionWrapper from '~/components/common/SectionWrapper.astro';

export interface Post {
  title: string;
  date: string; // ISO format: YYYY-MM-DD
  image: { src: string; alt: string };
  href: string;
  category?: string;
  excerpt?: string;
}

export interface Props {
  eyebrow?: string;
  heading: string;
  posts: Post[];
  viewAllLabel?: string;
  viewAllHref?: string;
  background?: 'base' | 'subtle' | 'accent2-light';
  spacing?: 'default' | 'tight' | 'loose';
}

const {
  eyebrow,
  heading,
  posts,
  viewAllLabel,
  viewAllHref,
  background = 'base',
  spacing = 'default',
} = Astro.props;

const bgMap: Record<string, string> = {
  base: 'bg-bg-base',
  subtle: 'bg-bg-subtle',
  'accent2-light': 'bg-accent2-light',
};
---

<SectionWrapper class={bgMap[background]} bg={background} spacing={spacing}>

  <div class="flex flex-col md:flex-row md:items-end md:justify-between gap-6 mb-12 md:mb-16">
    <div>
      {eyebrow && (
        <div class="flex items-center gap-4 mb-6">
          <span class="h-px w-8 bg-border-strong" aria-hidden="true"></span>
          <p class="eyebrow text-primary">{eyebrow}</p>
        </div>
      )}
      <h2 class="text-4xl md:text-5xl leading-[1.05]">{heading}</h2>
    </div>
    {viewAllLabel && viewAllHref && (
      <a href={viewAllHref} class="eyebrow inline-flex items-center gap-2 text-text-heading border-b border-text-heading/30 pb-1 hover:border-text-heading transition-colors duration-200 flex-shrink-0">
        {viewAllLabel}
        <Icon name="tabler:arrow-right" class="w-4 h-4" aria-hidden="true" />
      </a>
    )}
  </div>

  <div class="grid grid-cols-1 md:grid-cols-3 gap-x-10 gap-y-12">
    {posts.map((post) => (
      <a href={post.href} class="group flex flex-col focus-visible:outline-none">
        <div class="overflow-hidden mb-5 aspect-[3/2]">
          <img
            src={post.image.src}
            alt={post.image.alt}
            class="w-full h-full object-cover grayscale-[20%] transition-transform duration-500 group-hover:scale-105"
            loading="lazy"
            decoding="async"
          />
        </div>
        <div class="border-t border-border pt-5 flex flex-col flex-1">
          {post.category && <p class="eyebrow text-primary mb-3">{post.category}</p>}
          <h3 class="text-2xl leading-snug group-hover:text-text-base transition-colors duration-200">{post.title}</h3>
          {post.excerpt && <p class="mt-3 text-text-muted leading-relaxed flex-1">{post.excerpt}</p>}
          <span class="mt-5 inline-flex items-center gap-2 eyebrow text-text-heading border-b border-text-heading/30 pb-1 self-start group-hover:border-text-heading transition-colors duration-200">
            Read more
            <Icon name="tabler:arrow-right" class="w-4 h-4 transition-transform duration-200 group-hover:translate-x-1" aria-hidden="true" />
          </span>
        </div>
      </a>
    ))}
  </div>

</SectionWrapper>
