---
import Layout from '~/layouts/PageLayout.astro';
import PageHero from '~/components/sections/PageHero.astro';
import LegalContent from '~/components/sections/LegalContent.astro';

const metadata = {
  title: 'Disclaimer',
  description: 'Disclaimer for Meridian.',
  robots: { index: false, follow: true },
};
---

<Layout metadata={metadata} showLeadMagnet={false}>

  <PageHero variant="centered" background="subtle" heading="Disclaimer" />

  <LegalContent lastUpdated="[Month Year]">

