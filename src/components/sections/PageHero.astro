---
import Button from '~/components/ui/Button.astro';

export interface Props {
  eyebrow?: string;
  /**
   * Heading text. Supports inline HTML — use <em>, <span>, etc. directly.
   * Example: heading="Support that meets you <em>where you are</em>."
   */
  heading: string;
  body?: string[];
  image?: { src: string; alt: string; width?: number; height?: number };
  cta?: { text: string; href: string };
  background?: 'base' | 'accent-light' | 'accent2-light' | 'subtle';
  /**
   * Layout variants:
   *  split          — big display left, tall image right (default)
   *  fullbleed      — photo bg, ink gradient overlay
   *  fullbleed-dark — photo bg, deeper ink overlay, shorter
   *  panels         — ink left panel (text) + photo right panel
   *  centered       — no image, oversized centered display
   */
  variant?: 'split' | 'fullbleed' | 'fullbleed-dark' | 'panels' | 'centered';
  hideImageOnMobile?: boolean;
}

const {
  eyebrow,
  heading,
  body = [],
  image,
  cta,
  background = 'base',
  variant = 'split',
  hideImageOnMobile = false,
} = Astro.props;

const bgMap: Record<string, string> = {
  base: 'bg-bg-base',
  subtle: 'bg-bg-subtle',
  'accent-light': 'bg-accent-light',
  'accent2-light': 'bg-accent2-light',
};
---

{/* ─── FULLBLEED: ink gradient overlay ─── */}
{variant === 'fullbleed' && image && (
  <section class="relative py-24 md:py-40 lg:py-56 overflow-hidden" data-section-bg="fullbleed">
    <img src={image.src} alt="" aria-hidden="true" width={image.width} height={image.height}
      class="absolute inset-0 w-full h-full object-cover object-center grayscale-[20%]" loading="eager" decoding="async" />
    <div class="absolute inset-0 bg-gradient-to-r from-accent/90 via-accent/70 to-accent/20" />
    <div class="container-wide relative z-10">
      <div class="max-w-3xl">
        {eyebrow && (
          <div class="flex items-center gap-4 mb-6">
            <span class="h-px w-10 bg-white/40" aria-hidden="true"></span>
            <p class="eyebrow text-white/80">{eyebrow}</p>
          </div>
        )}
        <h1 class="text-white text-5xl md:text-7xl leading-[1.02]" set:html={heading} />
        {body.length > 0 && (
          <div class="mt-7 flex flex-col gap-4 max-w-xl">
            {body.map((p) => <p class="text-lg leading-relaxed text-white/80">{p}</p>)}
          </div>
        )}
        {cta && <div class="mt-9"><Button href={cta.href} variant="outline">{cta.text}</Button></div>}
      </div>
    </div>
  </section>
)}

{/* ─── FULLBLEED-DARK ─── */}
{variant === 'fullbleed-dark' && image && (
  <section class="relative py-20 md:py-32 lg:py-44 overflow-hidden" data-section-bg="fullbleed-dark">
    <img src={image.src} alt="" aria-hidden="true" width={image.width} height={image.height}
      class="absolute inset-0 w-full h-full object-cover object-center grayscale-[25%]" loading="eager" decoding="async" />
    <div class="absolute inset-0 bg-gradient-to-r from-[#141210]/92 via-[#141210]/72 to-[#141210]/25" />
    <div class="container-wide relative z-10">
      <div class="max-w-2xl">
        {eyebrow && (
          <div class="flex items-center gap-4 mb-6">
            <span class="h-px w-10 bg-white/40" aria-hidden="true"></span>
            <p class="eyebrow text-white/70">{eyebrow}</p>
          </div>
        )}
        <h1 class="text-white text-5xl md:text-7xl leading-[1.02]" set:html={heading} />
        {body.length > 0 && (
          <div class="mt-6 flex flex-col gap-3 max-w-xl">
            {body.map((p) => <p class="text-lg leading-relaxed text-white/75">{p}</p>)}
          </div>
        )}
        {cta && <div class="mt-9"><Button href={cta.href} variant="outline">{cta.text}</Button></div>}
      </div>
    </div>
  </section>
)}

{/* ─── PANELS: ink text panel + photo panel ─── */}
{variant === 'panels' && image && (
  <section class="grid grid-cols-1 md:grid-cols-[52fr_48fr] min-h-[560px]" data-section-bg="panels">
    <div
      class="bg-accent flex flex-col justify-center py-20 md:py-28 pr-10 md:pr-16"
      style="padding-left: max(1.5rem, calc((100vw - 96rem) / 2 + 3rem));"
    >
      <div class="max-w-xl">
        {eyebrow && (
          <div class="flex items-center gap-4 mb-6">
            <span class="h-px w-10 bg-white/40" aria-hidden="true"></span>
            <p class="eyebrow text-white/70">{eyebrow}</p>
          </div>
        )}
        <h1 class="text-white text-5xl md:text-7xl leading-[1.02]" set:html={heading} />
        {body.length > 0 && (
          <div class="mt-6 flex flex-col gap-3">
            {body.map((p) => <p class="text-lg leading-relaxed text-white/80">{p}</p>)}
          </div>
        )}
        {cta && <div class="mt-9"><Button href={cta.href} variant="outline">{cta.text}</Button></div>}
      </div>
    </div>

    <div class={`relative min-h-[320px] ${hideImageOnMobile ? 'hidden md:block' : ''}`}>
      <img src={image.src} alt={image.alt} width={image.width} height={image.height}
        class="absolute inset-0 w-full h-full object-cover object-center grayscale-[20%]"
        loading="eager" decoding="async" />
    </div>
  </section>
)}

{/* ─── CENTERED: oversized centered display, no image ─── */}
{variant === 'centered' && (
  <section class={`py-20 md:py-32 ${bgMap[background]}`} data-section-bg={background}>
    <div class="container-page">
      <div class="max-w-4xl mx-auto text-center">
        {eyebrow && (
          <div class="flex items-center justify-center gap-4 mb-7">
            <span class="h-px w-10 bg-border-strong" aria-hidden="true"></span>
            <p class="eyebrow text-primary">{eyebrow}</p>
            <span class="h-px w-10 bg-border-strong" aria-hidden="true"></span>
          </div>
        )}
        <h1 class="text-5xl md:text-8xl leading-[1.0]" set:html={heading} />
        {body.length > 0 && (
          <div class="mt-8 flex flex-col gap-4 max-w-2xl mx-auto">
            {body.map((p) => <p class="text-lg leading-relaxed text-text-muted">{p}</p>)}
          </div>
        )}
        {cta && <div class="mt-10 flex justify-center"><Button href={cta.href} variant="primary">{cta.text}</Button></div>}
      </div>
    </div>
  </section>
)}

{/* ─── SPLIT: big display left, tall image right (default) ─── */}
{(variant === 'split' || (!variant && image)) && (
  <section class={`py-16 md:py-24 ${bgMap[background]}`} data-section-bg={background}>
    <div class="container-wide">
      <div class={`grid grid-cols-1 gap-10 md:gap-16 items-end ${image ? 'lg:grid-cols-12' : ''}`}>

        <div class={image ? 'lg:col-span-7 lg:pb-6' : 'max-w-3xl'}>
          {eyebrow && (
            <div class="flex items-center gap-4 mb-7">
              <span class="h-px w-10 bg-border-strong" aria-hidden="true"></span>
              <p class="eyebrow text-primary">{eyebrow}</p>
            </div>
          )}
          <h1 class="text-5xl md:text-7xl lg:text-[5rem] leading-[1.0]" set:html={heading} />
          {body.length > 0 && (
            <div class="mt-8 flex flex-col gap-4 max-w-xl">
              {body.map((p) => <p class="text-lg leading-relaxed text-text-muted">{p}</p>)}
            </div>
          )}
          {cta && <div class="mt-9"><Button href={cta.href} variant="primary">{cta.text}</Button></div>}
        </div>

        {image && (
          <div class={`lg:col-span-5 ${hideImageOnMobile ? 'hidden md:block' : ''}`}>
            <img src={image.src} alt={image.alt} width={image.width} height={image.height}
              class="w-full aspect-[4/5] object-cover object-center grayscale-[15%]"
              loading="eager" decoding="async" />
          </div>
        )}

      </div>
    </div>
  </section>
)}
