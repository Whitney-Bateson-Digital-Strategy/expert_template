---
import { Icon } from 'astro-icon/components';
import SectionWrapper from '~/components/common/SectionWrapper.astro';

export interface CredentialGroup {
  label: string;
  icon?: string;
  items: string[];
}

export interface Props {
  eyebrow?: string;
  heading?: string;
  groups: CredentialGroup[];
  background?: 'base' | 'subtle' | 'accent-light' | 'accent2-light' | 'secondary';
}

const {
  eyebrow = 'Background',
  heading = 'Training & credentials.',
  groups,
  background = 'base',
} = Astro.props;

const bgMap: Record<string, string> = {
  base: 'bg-bg-base',
  subtle: 'bg-bg-subtle',
  'accent-light': 'bg-accent-light',
  'accent2-light': 'bg-accent2-light',
  secondary: 'bg-secondary',
};
---

<SectionWrapper class={bgMap[background]} bg={background}>

  <div class="grid grid-cols-1 lg:grid-cols-[1fr_1.6fr] gap-12 lg:gap-20 items-start">

    <!-- Sticky heading rail -->
    <div class="lg:sticky lg:top-32">
      {eyebrow && (
        <div class="flex items-center gap-4 mb-6">          <p class="eyebrow text-primary">{eyebrow}</p>
        </div>
      )}
      <h2 class="text-4xl md:text-5xl leading-[1.05]">{heading}</h2>
    </div>

    <!-- Credential groups -->
    <div class="border-t border-border">
      {groups.map((group) => (
        <div class="grid grid-cols-1 sm:grid-cols-[auto_1fr] gap-4 sm:gap-8 py-8 border-b border-border">
          <div class="flex items-center gap-3">
            <Icon name={group.icon ?? 'tabler:point'} class="w-5 h-5 text-primary" aria-hidden="true" />
            <p class="eyebrow text-text-heading">{group.label}</p>
          </div>
          <ul class="flex flex-col gap-2.5">
            {group.items.map((item) => (
              <li class="text-text-base leading-relaxed">{item}</li>
            ))}
          </ul>
        </div>
      ))}
    </div>

  </div>

</SectionWrapper>
