---
import { Icon } from 'astro-icon/components';
import Button from '~/components/ui/Button.astro';

export interface Props {
  eyebrow?: string;
  heading: string;
  intro?: string;
  items: string[];
  cta?: { text: string; href: string };
  background?: 'accent' | 'primary';
  spacing?: 'default' | 'tight';
}

const {
  eyebrow = 'Sound familiar?',
  heading,
  intro,
  items,
  cta,
  background = 'accent',
  spacing = 'default',
} = Astro.props;

const bgMap: Record<string, string> = {
  accent: 'bg-accent',
  primary: 'bg-primary',
};
---

<section class={`${spacing === 'tight' ? 'section-py-tight' : 'section-py'} ${bgMap[background]}`} data-section-bg={background}>
  <div class="container-page">

    <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-16 items-start">

      <!-- Heading rail -->
      <div class="lg:col-span-5 lg:sticky lg:top-32">
        {eyebrow && (
          <div class="flex items-center gap-4 mb-6">            <p class="eyebrow text-white/60">{eyebrow}</p>
          </div>
        )}
        <h2 class="text-white text-4xl md:text-6xl leading-[1.03]" set:html={heading} />
        {intro && <p class="mt-6 text-white/70 leading-relaxed max-w-md">{intro}</p>}
        {cta && (
          <div class="mt-9 hidden lg:block">
            <Button href={cta.href} variant="outline">{cta.text}</Button>
          </div>
        )}
      </div>

      <!-- Checklist -->
      <ul class="lg:col-span-7 border-t border-white/20">
        {items.map((item, i) => (
          <li
            class="flex items-start gap-5 py-5 border-b border-white/20"
            data-reveal
            data-reveal-delay={i * 70}
          >
            <Icon name="tabler:check" class="w-5 h-5 mt-1 text-white/50 flex-shrink-0" aria-hidden="true" />
            <span class="text-white/90 text-lg leading-snug">{item}</span>
          </li>
        ))}
      </ul>

    </div>

    {cta && (
      <div class="mt-10 lg:hidden">
        <Button href={cta.href} variant="outline">{cta.text}</Button>
      </div>
    )}

  </div>
</section>
